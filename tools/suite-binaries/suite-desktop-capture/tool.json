{
  "schema": "com.takesome.springsuite.tool.v1",
  "id": "suite-desktop-capture",
  "name": "suite-desktop-capture",
  "title": "Suite Desktop Capture",
  "kind": "go-sidecar",
  "source_type": "suite-local",
  "package_root": ".",
  "description": "Local Windows desktop sidecar for screenshots, active-form inspection and guarded native form actions.",
  "executable": "suiteBinaries/suite-desktop-capture",
  "default_args": [
    "doctor"
  ],
  "validation_args": [
    "doctor"
  ],
  "capabilities": [
    "desktop-screenshot",
    "active-window-inspection",
    "native-form-detection",
    "guarded-native-form-fill",
    "local-http-sidecar",
    "json-output",
    "base64-output",
    "fn-handoff"
  ],
  "tags": [
    "go",
    "sidecar",
    "desktop",
    "screenshot",
    "vision",
    "fn"
  ],
  "safe_commands": [
    "version",
    "doctor",
    "help",
    "screenshot",
    "capture",
    "inspect",
    "fill",
    "serve"
  ],
  "runtime": {
    "working_directory": "."
  }
}
