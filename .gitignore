# Gradle and JVM build output
.gradle/
build/
**/build/
out/
target/
*.class

# IDE and editor metadata
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# SpringSuite local runtime state
/.springsuite/
/.springsuite-patch-backups/
**/.springsuite-repository.json
/config/*
!/config/runtime-controller.json
!/config/suite-cloudflared.yml
/data/
/logs/
/modules/
/authority/

# Generated deployment artifacts
/spring-suite.jar
/spring-suite.jar.bak-*
/deploy-manifest.json
/DEPLOY_MANIFEST.json
/MIGRATION-REPORT.json
/build/distributions/

# Native build/debug outputs outside the production suiteBinaries payload
/native/go/**/*.exe
/native/go/**/*.test
/suiteBinaries/*-debug.exe
/suiteBinaries/*.bak-*

# Temporary and backup files
/tmp/
*.tmp
*.temp
*.bak
*.bak-*
*~

# Local secrets and environment overrides
.env
.env.*
!.env.example
*.local.yml
*.local.yaml
